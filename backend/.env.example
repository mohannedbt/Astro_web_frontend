# Copy this file to .env and fill in secret values before running the backend.

PORT=5000
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Local development: leave DATABASE_URL empty to use SQLite locally.
DATABASE_URL=
REDIS_URL=redis://127.0.0.1:6379

# Production / hosted services:
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
# REDIS_URL=redis://:password@host:6379

SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
