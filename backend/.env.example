# Copy this file to .env and fill in secret values before running the backend.

PORT=5000
JWT_SECRET=replace-with-your-secret
JWT_EXPIRES_IN=7d
DATABASE_URL=postgresql://user:password@host:port/dbname?sslmode=require
REDIS_URL=redis://user:password@host:port
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
