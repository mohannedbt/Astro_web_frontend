# Copy this file to .env and fill in secret values before running the backend.

PORT=5000
NODE_ENV=development

# Required in production, 32+ random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Local development: leave DATABASE_URL empty to use SQLite locally.
# NOTE: SQLite lives on local disk. On hosts with ephemeral disks (Render free
# tier, Heroku...) it is wiped on every deploy, so always use Postgres there.
DATABASE_URL=
# DATABASE_SSL_NO_VERIFY=true   # only for Postgres hosts with a self-signed cert
# DATABASE_SSL=false            # only for a local Postgres without TLS
REDIS_URL=

# Comma-separated frontend origins allowed to call the API (unset = allow all).
CORS_ORIGINS=http://localhost:5173

# Number of reverse proxies in front of the app (1 for Render/Heroku/Fly).
TRUST_PROXY=1

# Admin account created on first start. In production ADMIN_PASS is required.
ADMIN_EMAIL=admin@astro.local
ADMIN_USERNAME=admin
ADMIN_PASS=

SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
