# Copy this file to .env.docker and fill in real values. Never commit .env.docker.

# Postgres connection string (e.g. from Neon / Render)
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-64-random-hex-characters
JWT_EXPIRES_IN=7d

# Comma-separated list of frontend origins allowed to call the API
CORS_ORIGINS=https://your-frontend.example.com

# Admin account created on first start
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_PASS=replace-with-a-strong-password
